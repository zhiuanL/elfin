{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "elfin Character Package schema 1",
  "$comment": "Runtime validation is implemented by CharacterSchema and CharacterPackageValidator; this file is an authoring aid. Resource existence, safe Windows paths, PNG decoding, limits, semantic references, app compatibility and tier are checked locally without fetching this URI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageVersion", "minimumAppVersion", "id", "assets", "animations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageVersion": { "$ref": "#/$defs/version" },
    "minimumAppVersion": { "$ref": "#/$defs/version" },
    "id": { "type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "defaultLocale": { "$ref": "#/$defs/locale", "default": "zh-CN" },
    "targetTier": { "enum": ["basic", "standard", "full"], "default": "basic" },
    "isDevelopmentFixture": { "type": "boolean", "default": false },
    "assets": {
      "type": "object", "additionalProperties": false, "required": ["preview", "fallback"],
      "properties": { "preview": { "$ref": "#/$defs/path" }, "fallback": { "$ref": "#/$defs/path" } }
    },
    "animations": {
      "type": "object", "required": ["idle"],
      "propertyNames": { "$ref": "#/$defs/semantic" },
      "additionalProperties": { "$ref": "#/$defs/animation" }
    },
    "locales": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/locale" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["name", "description"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 }, "description": { "type": "string", "maxLength": 4000 } }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "persona": { "type": "boolean" }, "dialogue": { "type": "boolean" }, "emotionMap": { "type": "boolean" },
        "hitAreas": { "type": "boolean" }, "behaviorProfile": { "type": "boolean" }, "ttsProfile": { "type": "boolean" },
        "lipSync": { "type": "boolean" }, "layered2D": { "type": "boolean" }, "live2D": { "type": "boolean" }
      }
    },
    "profiles": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "persona": { "$ref": "#/$defs/localizedPaths" }, "dialogue": { "$ref": "#/$defs/localizedPaths" },
        "emotionMap": { "$ref": "#/$defs/nullablePath" }, "hitAreas": { "$ref": "#/$defs/nullablePath" },
        "behaviorProfile": { "$ref": "#/$defs/nullablePath" }, "voice": { "$ref": "#/$defs/nullablePath" }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "locale": { "enum": ["zh-CN", "en-US"] },
    "semantic": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 240, "description": "Relative slash-separated path; dot segments, backslashes, control characters, Windows device names and ADS are forbidden by PackagePath." },
    "nullablePath": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
    "localizedPaths": { "type": "object", "propertyNames": { "$ref": "#/$defs/locale" }, "additionalProperties": { "$ref": "#/$defs/path" } },
    "frame": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "durationMs": { "type": ["integer", "null"], "minimum": 1, "maximum": 60000 } }
    },
    "animation": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["static", "sequence", "layered2d", "live2d"] },
        "path": { "$ref": "#/$defs/nullablePath" },
        "frames": { "type": ["array", "null"], "minItems": 1, "items": { "$ref": "#/$defs/frame" } },
        "fps": { "type": "integer", "minimum": 1, "maximum": 60, "default": 12 },
        "loop": { "type": "boolean", "default": true },
        "fallback": { "anyOf": [{ "$ref": "#/$defs/semantic" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "static" } } }, "then": { "required": ["path"], "properties": { "path": { "$ref": "#/$defs/path" }, "frames": { "type": "null" } } } },
        { "if": { "properties": { "type": { "const": "sequence" } } }, "then": { "oneOf": [
          { "required": ["path"], "properties": { "path": { "$ref": "#/$defs/path" }, "frames": { "type": "null" } } },
          { "required": ["frames"], "properties": { "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/frame" } }, "path": { "type": "null" } } }
        ] } }
      ]
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "persona": {
      "type": "object", "additionalProperties": false, "required": ["summary", "traits"],
      "properties": { "summary": { "$ref": "#/$defs/text" }, "traits": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/text" } } }
    },
    "dialogue": {
      "type": "object", "additionalProperties": false, "required": ["lines"],
      "properties": { "lines": { "type": "object", "minProperties": 1, "maxProperties": 100, "propertyNames": { "$ref": "#/$defs/semantic" }, "additionalProperties": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/text" } } } }
    },
    "emotion": {
      "type": "object", "additionalProperties": false, "required": ["animations"],
      "properties": { "animations": { "type": "object", "minProperties": 1, "maxProperties": 50, "propertyNames": { "$ref": "#/$defs/semantic" }, "additionalProperties": { "$ref": "#/$defs/semantic" } } }
    },
    "hitareas": {
      "type": "object", "additionalProperties": false, "required": ["areas"],
      "properties": { "areas": { "type": "array", "minItems": 1, "maxItems": 32, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "x", "y", "width", "height"],
        "properties": {
          "id": { "$ref": "#/$defs/semantic" }, "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "width": { "type": "number", "minimum": 0.001, "maximum": 1 }, "height": { "type": "number", "minimum": 0.001, "maximum": 1 }
        }
      } } }
    },
    "behavior": {
      "type": "object", "additionalProperties": false, "required": ["behaviors"],
      "properties": { "behaviors": { "type": "array", "minItems": 1, "maxItems": 100, "items": {
        "type": "object", "additionalProperties": false, "required": ["animation", "weight", "cooldownSeconds"],
        "properties": { "animation": { "$ref": "#/$defs/semantic" }, "weight": { "type": "number", "minimum": 0, "maximum": 10 }, "cooldownSeconds": { "type": "number", "minimum": 0, "maximum": 3600 } }
      } } }
    },
    "voice": {
      "type": "object", "additionalProperties": false, "required": ["provider", "voice"],
      "properties": { "provider": { "$ref": "#/$defs/text" }, "voice": { "$ref": "#/$defs/text" }, "speed": { "type": "number", "minimum": 0.5, "maximum": 2, "default": 1 }, "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 } }
    }
  }
}
