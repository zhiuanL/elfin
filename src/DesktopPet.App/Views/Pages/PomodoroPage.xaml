<UserControl x:Class="DesktopPet.App.Views.Pages.PomodoroPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleStyle}" Margin="0,6,0,20"/>
    <Border Style="{StaticResource CardStyle}"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding Phase}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Text="{Binding Remaining}" FontSize="52" FontWeight="Light" Margin="0,12"/>
        <TextBlock Text="{Binding Consecutive}"/><TextBlock Text="{Binding TodayFocus}"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{Binding StartText}" Command="{Binding StartCommand}"/>
        <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}"/><Button Content="{Binding ResumeText}" Command="{Binding ResumeCommand}"/>
        <Button Content="{Binding StopText}" Command="{Binding StopCommand}"/></StackPanel>
    </Grid></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{Binding TaskText}" FontWeight="SemiBold"/>
        <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" DisplayMemberPath="Title" Height="100" Margin="0,8"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="{Binding AddTaskText}" Command="{Binding AddTaskCommand}"/>
          <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/></DockPanel>
        <Button Content="{Binding ArchiveTaskText}" Command="{Binding ArchiveTaskCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{Binding TagsText}" FontWeight="SemiBold"/>
        <ListBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" DisplayMemberPath="Name" Height="100" Margin="0,8"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="{Binding AddTagText}" Command="{Binding AddTagCommand}"/>
          <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/></DockPanel>
        <Button Content="{Binding AssignTagText}" Command="{Binding AssignTagCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    </Grid>
    <Expander Header="{Binding SettingsText}"><Border Style="{StaticResource CardStyle}"><StackPanel>
      <UniformGrid Columns="4"><StackPanel><TextBlock Text="{Binding FocusDurationText}"/><TextBox Text="{Binding FocusMinutes}"/></StackPanel>
        <StackPanel><TextBlock Text="{Binding ShortBreakDurationText}"/><TextBox Text="{Binding ShortBreakMinutes}"/></StackPanel>
        <StackPanel><TextBlock Text="{Binding LongBreakDurationText}"/><TextBox Text="{Binding LongBreakMinutes}"/></StackPanel>
        <StackPanel><TextBlock Text="{Binding LongBreakIntervalText}"/><TextBox Text="{Binding LongBreakInterval}"/></StackPanel></UniformGrid>
      <CheckBox Content="{Binding AutoStartText}" IsChecked="{Binding AutoStartNextPhase}" Margin="0,12"/>
      <Button Content="{Binding SaveText}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentBrush}"/>
    </StackPanel></Border></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
