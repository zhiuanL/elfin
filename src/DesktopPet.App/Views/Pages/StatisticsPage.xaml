<UserControl x:Class="DesktopPet.App.Views.Pages.StatisticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleStyle}" Margin="0,6,0,20"/>
    <UniformGrid Columns="3"><Border Style="{StaticResource CardStyle}"><TextBlock Text="{Binding TodayFocus}" FontSize="20"/></Border>
      <Border Style="{StaticResource CardStyle}"><TextBlock Text="{Binding TodayCompleted}" FontSize="20"/></Border>
      <Border Style="{StaticResource CardStyle}"><TextBlock Text="{Binding Streak}" FontSize="20"/></Border></UniformGrid>
    <UniformGrid Columns="3"><GroupBox Header="{Binding DailyTitle}"><ListBox ItemsSource="{Binding Daily}"/></GroupBox>
      <GroupBox Header="{Binding WeeklyTitle}"><ListBox ItemsSource="{Binding Weekly}"/></GroupBox>
      <GroupBox Header="{Binding MonthlyTitle}"><ListBox ItemsSource="{Binding Monthly}"/></GroupBox></UniformGrid>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <GroupBox Header="{Binding TaskTitle}"><ListBox ItemsSource="{Binding Tasks}" MinHeight="120"/></GroupBox>
      <GroupBox Grid.Column="1" Header="{Binding TagTitle}"><ListBox ItemsSource="{Binding Tags}" MinHeight="120"/></GroupBox>
    </Grid>
  </StackPanel></ScrollViewer>
</UserControl>
