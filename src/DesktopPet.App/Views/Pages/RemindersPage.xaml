<UserControl x:Class="DesktopPet.App.Views.Pages.RemindersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleStyle}" Margin="0,6,0,20"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="0,0,14,0">
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Schedule.Type}" Opacity="0.7"/>
          <TextBlock Text="{Binding NextTriggerAtUtc}" Opacity="0.7"/>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource CardStyle}"><StackPanel>
        <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource DangerBrush}"/>
        <TextBlock Text="{Binding TitleLabel}"/><TextBox Text="{Binding ReminderTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
        <TextBlock Text="{Binding DescriptionLabel}"/><TextBox Text="{Binding Description}" Height="55" AcceptsReturn="True" Margin="0,4,0,8"/>
        <TextBlock Text="{Binding ScheduleText}"/><ComboBox ItemsSource="{Binding ScheduleTypes}" SelectedItem="{Binding ScheduleType}" Margin="0,4,0,8"/>
        <TextBlock Text="{Binding RelativeMinutesLabel}"/><TextBox Text="{Binding RelativeMinutes}" Margin="0,4,0,8"/>
        <TextBlock Text="{Binding AbsoluteLocalLabel}"/><TextBox Text="{Binding AbsoluteLocal}" Margin="0,4,0,8"/>
        <TextBlock Text="{Binding RecurrenceText}"/><ComboBox ItemsSource="{Binding RecurrenceKinds}" SelectedItem="{Binding RecurrenceKind}" Margin="0,4,0,8"/>
        <DockPanel><TextBlock Text="{Binding RecurringTimeLabel}" VerticalAlignment="Center"/><TextBox Text="{Binding RecurringTime}" Width="75" Margin="6,0"/>
          <TextBlock Text="{Binding IntervalDaysLabel}" VerticalAlignment="Center"/><TextBox Text="{Binding IntervalDays}" Width="55" Margin="6,0"/>
          <TextBlock Text="{Binding WeekdaysLabel}" VerticalAlignment="Center"/><TextBox Text="{Binding Weekdays}" Margin="6,0,0,8"/></DockPanel>
        <TextBlock Text="{Binding TimeZoneText}"/><TextBox Text="{Binding TimeZoneId}" Margin="0,4,0,8"/>
        <TextBlock Text="{Binding ChannelsText}"/><WrapPanel><CheckBox Content="{Binding PetBubbleLabel}" IsChecked="{Binding PetBubble}"/>
          <CheckBox Content="{Binding PetActionLabel}" IsChecked="{Binding PetAction}"/><CheckBox Content="{Binding WindowsLabel}" IsChecked="{Binding WindowsNotification}"/>
          <CheckBox Content="{Binding SoundLabel}" IsChecked="{Binding Sound}"/></WrapPanel>
        <WrapPanel Margin="0,14,0,0"><Button Content="{Binding AddText}" Command="{Binding AddCommand}"/>
          <Button Content="{Binding UpdateText}" Command="{Binding UpdateCommand}"/><Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"/>
          <Button Content="{Binding DeleteText}" Command="{Binding DeleteCommand}"/></WrapPanel>
      </StackPanel></Border></ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
