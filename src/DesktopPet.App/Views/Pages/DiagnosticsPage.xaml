<UserControl x:Class="DesktopPet.App.Views.Pages.DiagnosticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleStyle}" Margin="0,6,0,10"/><TextBlock Text="{Binding OfflineStatus}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>
    <GroupBox DataContext="{Binding Runtime}" Header="{Binding Heading}" Margin="0,0,0,14"><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="180" VerticalScrollBarVisibility="Auto" Margin="10"/></GroupBox>
    <GroupBox DataContext="{Binding Characters}" Header="{Binding Heading}"><StackPanel Margin="10"><TextBlock Text="{Binding SourceHint}" TextWrapping="Wrap"/><DockPanel Margin="0,8"><Button DockPanel.Dock="Right" Content="{Binding BrowseZipText}" Command="{Binding BrowseZipCommand}"/><Button DockPanel.Dock="Right" Content="{Binding ValidateText}" Command="{Binding ValidateCommand}"/><TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto"/></StackPanel></GroupBox>
  </StackPanel></ScrollViewer>
</UserControl>
