<UserControl x:Class="DesktopPet.App.Views.Pages.AiPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleStyle}" Margin="0,6,0,16"/><TextBlock Text="{Binding Notice}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
      <GroupBox Header="{Binding ConversationsText}" Margin="0,0,10,0"><DockPanel>
        <StackPanel DockPanel.Dock="Bottom"><Button Content="{Binding NewTemporaryText}" Command="{Binding NewTemporaryCommand}"/><Button Content="{Binding NewTopicText}" Command="{Binding NewTopicCommand}"/></StackPanel>
        <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel></GroupBox>
      <GroupBox Grid.Column="1" Header="{Binding MessagesText}" Margin="0,0,10,0"><DockPanel>
        <StackPanel DockPanel.Dock="Bottom"><TextBox Text="{Binding Input,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" PreviewKeyDown="OnInputPreviewKeyDown"/>
          <WrapPanel Margin="0,8,0,0"><Button Content="{Binding SendText}" Command="{Binding SendCommand}"/><Button Content="{Binding StopText}" Command="{Binding StopCommand}"/><Button Content="{Binding RetryText}" Command="{Binding RetryCommand}"/></WrapPanel></StackPanel>
        <ListBox ItemsSource="{Binding Messages}" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Padding="8" Margin="2" Background="{DynamicResource SurfaceBrush}"><StackPanel><TextBlock Text="{Binding Header}" FontWeight="SemiBold"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel></GroupBox>
      <TabControl Grid.Column="2"><TabItem Header="{Binding ProviderText}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
        <TextBlock Text="{Binding SetupTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding ProviderProfiles}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="DisplayName" Height="80"/>
        <TextBlock Text="{Binding ProviderText}"/><ComboBox ItemsSource="{Binding ProviderTypes}" SelectedItem="{Binding ProviderType}"/><TextBlock Text="{Binding DisplayNameText}"/><TextBox Text="{Binding ProviderName,UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{Binding BaseUrlText}"/><TextBox Text="{Binding BaseUrl,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding ModelText}"/><ComboBox ItemsSource="{Binding AvailableModels}" Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True"/>
        <TextBlock Text="{Binding ApiKeyText}"/><PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnPasswordChanged"/><CheckBox Content="{Binding SaveKeyText}" IsChecked="{Binding SaveKey}"/><TextBlock Text="{Binding TimeoutText}"/><TextBox Text="{Binding TimeoutSeconds}"/>
        <WrapPanel><Button Content="{Binding NewProviderText}" Command="{Binding NewProviderCommand}"/><Button Content="{Binding FetchModelsText}" Command="{Binding FetchModelsCommand}"/><Button Content="{Binding SaveProviderText}" Command="{Binding SaveProviderCommand}"/><Button Content="{Binding TestConnectionText}" Command="{Binding TestProviderCommand}"/><Button Content="{Binding SetActiveText}" Command="{Binding SetActiveCommand}"/><Button Content="{Binding DeleteProviderText}" Command="{Binding DeleteProviderCommand}"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{Binding MemoryText}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
        <CheckBox Content="{Binding AutoMemoryText}" IsChecked="{Binding AutoMemory}"/><ListBox ItemsSource="{Binding Memories}" SelectedItem="{Binding SelectedMemory}" DisplayMemberPath="Content" Height="120"/>
        <TextBlock Text="{Binding MemoryContentText}"/><TextBox Text="{Binding MemoryContent,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"/><TextBlock Text="{Binding CategoryText}"/><ComboBox ItemsSource="{Binding MemoryCategories}" SelectedItem="{Binding MemoryCategory}"/>
        <TextBlock Text="{Binding ImportanceText}"/><Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MemoryImportance}"/><TextBlock Text="{Binding TagsText}"/><TextBox Text="{Binding MemoryTags}"/><TextBlock Text="{Binding KeywordsText}"/><TextBox Text="{Binding MemoryKeywords}"/>
        <WrapPanel><Button Content="{Binding SaveMemoryText}" Command="{Binding SaveMemoryCommand}"/><Button Content="{Binding DeleteMemoryText}" Command="{Binding DeleteMemoryCommand}"/><Button Content="{Binding ClearCharacterText}" Command="{Binding ClearCharacterMemoriesCommand}"/><Button Content="{Binding ClearAllText}" Command="{Binding ClearAllMemoriesCommand}"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem></TabControl>
    </Grid>
  </Grid>
</UserControl>
