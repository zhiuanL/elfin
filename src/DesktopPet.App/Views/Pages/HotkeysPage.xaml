<UserControl x:Class="DesktopPet.App.Views.Pages.HotkeysPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleStyle}" Margin="0,6,0,18"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Bindings}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.Modifiers, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValue="{Binding Modifiers}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="8,0"/>
        <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.Keys, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Key}" Margin="8,0,0,0"/>
      </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel Grid.Row="2"><TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,6"/><WrapPanel><Button Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"/><Button Content="{Binding ResetText}" Command="{Binding ResetCommand}"/></WrapPanel></StackPanel>
  </Grid>
</UserControl>
