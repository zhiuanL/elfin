<UserControl x:Class="DesktopPet.App.Views.Pages.CharactersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleStyle}" Margin="0,6,0,18"/></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="{Binding BrowseText}" Command="{Binding BrowseCommand}"/><Button DockPanel.Dock="Right" Content="{Binding ValidateText}" Command="{Binding ValidateCommand}"/><Button DockPanel.Dock="Right" Content="{Binding ImportText}" Command="{Binding ImportCommand}"/><TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,8"/></DockPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}"><DockPanel><Button DockPanel.Dock="Bottom" Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" Margin="0,10,0,0"/><ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="  ●" Foreground="{DynamicResource AccentBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Text="{Binding Level}" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Selected}">
        <Image Source="{Binding Preview}" Width="180" Height="180" Stretch="Uniform" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding PackageVersion}" Margin="0,10,0,0"/><TextBlock Text="{Binding Capabilities}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding MissingCapabilities}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,18,0,0"><Button Content="{Binding ActivateText}" Command="{Binding ActivateCommand}"/><Button Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" Foreground="{DynamicResource DangerBrush}"/></StackPanel>
        <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/><TextBox DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding Validation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="110" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"/>
      </StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
