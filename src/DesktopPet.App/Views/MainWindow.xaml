<Window x:Class="DesktopPet.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="840" Height="740" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
  <Grid Margin="40">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{Binding Heading}" FontSize="32" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" FontSize="16" Margin="0,16,0,0" />
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12">
    <StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="14" />
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,0" />
      <GroupBox DataContext="{Binding CharacterTools}" Header="{Binding Heading}" Margin="0,16,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{Binding SourceHint}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,6,0,0">
            <Button Content="{Binding BrowseZipText}" Command="{Binding BrowseZipCommand}" Padding="8,4" Margin="0,0,6,4" />
            <Button Content="{Binding BrowseFolderText}" Command="{Binding BrowseFolderCommand}" Padding="8,4" Margin="0,0,0,4" />
          </WrapPanel>
          <DockPanel Margin="0,6">
            <Button DockPanel.Dock="Right" Content="{Binding ValidateText}" Command="{Binding ValidateCommand}" Padding="8,4" />
            <Button DockPanel.Dock="Right" Content="{Binding ImportText}" Command="{Binding ImportCommand}" Padding="8,4" Margin="6,0" />
            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" MaxLength="1024" />
          </DockPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" Padding="8,4" />
            <Button DockPanel.Dock="Right" Content="{Binding ActivateText}" Command="{Binding ActivateCommand}" Padding="8,4" Margin="6,0" />
            <Button DockPanel.Dock="Right" Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" Padding="8,4" Margin="6,0" />
            <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding Selected}" DisplayMemberPath="DisplayName" />
          </DockPanel>
          <DockPanel Margin="0,6">
            <Button DockPanel.Dock="Right" Content="{Binding PlayText}" Command="{Binding PlayCommand}" Padding="8,4" />
            <TextBox Text="{Binding Semantic, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
          </DockPanel>
          <TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </GroupBox>
      <GroupBox DataContext="{Binding Movement}" Header="{Binding Heading}" Margin="0,8,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,6">
            <ComboBox ItemsSource="{Binding Modes}" SelectedValue="{Binding Mode}" SelectedValuePath="Value" DisplayMemberPath="Label" MinWidth="130" Margin="0,0,6,4" />
            <ComboBox ItemsSource="{Binding Displays}" SelectedValue="{Binding Display}" SelectedValuePath="Value" DisplayMemberPath="Label" MinWidth="130" Margin="0,0,6,4" />
            <ComboBox ItemsSource="{Binding Styles}" SelectedValue="{Binding Style}" SelectedValuePath="Value" DisplayMemberPath="Label" MinWidth="100" Margin="0,0,6,4" />
            <ComboBox ItemsSource="{Binding Hybrids}" SelectedItem="{Binding Hybrid}" MinWidth="120" Margin="0,0,0,4" />
          </WrapPanel>
          <TextBox Text="{Binding SelectedIds, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" Margin="0,0,0,6" />
          <WrapPanel>
            <Button Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" Padding="8,4" Margin="0,0,6,4" />
            <Button Content="{Binding InteractiveText}" Command="{Binding InteractiveCommand}" Padding="8,4" Margin="0,0,6,4" />
            <Button Content="{Binding ClickThroughText}" Command="{Binding ClickThroughCommand}" Padding="8,4" Margin="0,0,6,4" />
            <Button Content="{Binding TemporaryText}" Command="{Binding TemporaryCommand}" Padding="8,4" Margin="0,0,6,4" />
            <Button Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" Padding="8,4" Margin="0,0,0,4" />
          </WrapPanel>
          <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="105" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </GroupBox>
      <GroupBox DataContext="{Binding Runtime}" Header="{Binding Heading}" Margin="0,8,0,0">
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 Height="170" VerticalScrollBarVisibility="Auto" Margin="8" />
      </GroupBox>
    </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
      <Button Content="{Binding ShowText}" Command="{Binding ShowCommand}" Padding="12,8" Margin="0,0,8,8" />
      <Button Content="{Binding HideText}" Command="{Binding HideCommand}" Padding="12,8" Margin="0,0,8,8" />
      <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Padding="12,8" Margin="0,0,8,8" />
      <Button Content="{Binding CloseText}" Command="{Binding CloseCommand}" Padding="12,8" Margin="0,0,8,8" />
      <Button Content="{Binding ExitText}" Command="{Binding ExitCommand}" Padding="12,8" Margin="0,0,0,8" />
    </WrapPanel>
  </Grid>
</Window>
