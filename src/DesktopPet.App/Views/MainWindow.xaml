<Window x:Class="DesktopPet.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DesktopPet.App.ViewModels"
        xmlns:pages="clr-namespace:DesktopPet.App.Views.Pages"
        Title="{Binding Title}" Width="1120" Height="760" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" UseLayoutRounding="True">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:HomeDashboardViewModel}"><pages:HomePage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PomodoroViewModel}"><pages:PomodoroPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RemindersViewModel}"><pages:RemindersPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StatisticsViewModel}"><pages:StatisticsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CharacterManagerViewModel}"><pages:CharactersPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HotkeysViewModel}"><pages:HotkeysPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsPageViewModel}"><pages:DiagnosticsPage /></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" Margin="8,8,8,24"/>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Content="{Binding Label}" Command="{Binding Command}" HorizontalContentAlignment="Left" BorderThickness="0" Margin="0,0,0,6" Padding="14,11">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="2">
          <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="6,0,6,8"/>
          <WrapPanel><Button Content="{Binding CloseText}" Command="{Binding CloseCommand}"/><Button Content="{Binding ExitText}" Command="{Binding ExitCommand}"/></WrapPanel>
        </StackPanel>
      </Grid>
    </Border>
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="30"/>
  </Grid>
</Window>
