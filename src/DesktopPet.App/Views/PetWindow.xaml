<Window x:Class="DesktopPet.App.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="220" Height="220" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
  <!-- Phase 1 vector placeholder only; no character resources or runtime semantics. -->
  <Grid ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Hint}">
    <Ellipse Width="164" Height="24" VerticalAlignment="Bottom" Margin="0,0,0,16" Fill="#20000000" />
    <Border Width="160" Height="154" CornerRadius="72" Background="#EDEAF6FF"
            BorderBrush="#B386B5D6" BorderThickness="2" VerticalAlignment="Center">
      <Grid>
        <Ellipse Width="12" Height="18" Fill="#304766" HorizontalAlignment="Left" Margin="38,0,0,8" />
        <Ellipse Width="12" Height="18" Fill="#304766" HorizontalAlignment="Right" Margin="0,0,38,8" />
        <Path Data="M 0,0 Q 10,12 20,0" Stroke="#304766" StrokeThickness="3"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,38,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
